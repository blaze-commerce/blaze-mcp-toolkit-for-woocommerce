{
  "schema_version": 1,
  "rule_version": 1,
  "purpose": "Synthetic order patterns for the card-testing rules (FEATURE-PLAN item 3, contract C5). Each vector is expanded into compact order rows, folded by the real CardTestingOrders accumulator and evaluated by CardTestingRules. All values are invented test shapes, never store data. IP addresses are documentation and private ranges only.",
  "now": 1795000000,
  "generator": {
    "fields": "method (default stripe), via (default checkout; empty string = missing origin), status, paid (true = paid 60 seconds after creation), count, from/to (seconds before now, orders spread evenly over [now - from, now - to)) or at (seconds before now, every order at that instant), ip, attr, repeat {every, times} (copies shifted closer to now by every seconds), invalid (true = malformed creation date)",
    "ip": "missing | invalid (a list) | networks:N[:base] (N recorded /24 networks) | distinct[:base] (one /24 per order) | v6:N (N /64 networks); or a list of [mode, count] pairs applied in order",
    "attr": "absent (no meta row) | none ((none)) | typein | utm | organic | bogus (unrecognised text) | long (over 64 bytes); or a list of [value, count] pairs applied in order"
  },
  "templates": {
    "healthy_baseline": [
      { "status": "processing", "paid": true, "count": 2400, "from": 2419200, "to": 172800, "ip": "distinct:1", "attr": [ [ "typein", 1680 ], [ "absent", 720 ] ] },
      { "status": "failed", "count": 240, "from": 2419200, "to": 172800, "ip": "distinct:2", "attr": [ [ "typein", 168 ], [ "absent", 72 ] ] }
    ],
    "healthy_current": [
      { "status": "processing", "paid": true, "count": 180, "from": 172800, "to": 3600, "ip": "distinct:3", "attr": [ [ "typein", 126 ], [ "absent", 54 ] ] },
      { "status": "failed", "count": 18, "from": 172800, "to": 3600, "ip": "distinct:4", "attr": "typein" }
    ]
  },
  "vectors": [
    {
      "name": "corroborated_recent_burst",
      "about": "Corroborated burst in the last hour: high failed share, 3 recorded networks, no recorded marketing source against a populated baseline, still running in the last 15 minutes.",
      "use": [ "healthy_baseline", "healthy_current" ],
      "orders": [
        { "status": "failed", "count": 120, "from": 3600, "to": 0, "ip": "networks:3", "attr": "absent" },
        { "status": "processing", "paid": true, "count": 5, "from": 3600, "to": 0, "ip": "distinct:5", "attr": "typein" }
      ],
      "expect": { "verdict": "likely_attack", "activity": "recent", "coverage": "complete", "findings_include": [ "likely_card_testing" ], "assessment": { "method_id": "stripe", "origin_scope": "verified_checkout", "verdict": "likely_attack", "activity": "recent" } }
    },
    {
      "name": "recovered_earlier_burst",
      "about": "The same corroborated burst 19 to 20 hours ago and nothing unusual since.",
