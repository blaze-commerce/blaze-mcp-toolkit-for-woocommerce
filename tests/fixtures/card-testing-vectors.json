        { "status": "processing", "paid": true, "count": 5, "from": 72000, "to": 68400, "ip": "distinct:5", "attr": "typein" }
      ],
      "expect": { "verdict": "likely_attack", "activity": "earlier_in_window", "findings_include": [ "likely_card_testing" ] }
    },
    {
      "name": "continued_recent_burst",
      "about": "A burst running for the last 3 hours: 3 non-overlapping representative hours, whole-window failed count distinct (never a sum of overlapping hours).",
