        { "status": "processing", "paid": true, "count": 15, "from": 10800, "to": 0, "ip": "distinct:5", "attr": "typein" }
      ],
      "expect": { "verdict": "likely_attack", "activity": "recent", "assessment": { "method_id": "stripe", "origin_scope": "verified_checkout", "verdict": "likely_attack", "failed_unpaid": 378, "episodes": 3, "episodes_truncated": false } }
    },
    {
