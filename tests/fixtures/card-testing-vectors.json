      "expect": { "verdict": "possible_attack", "never": [ "likely_attack" ], "findings_include": [ "possible_card_testing" ], "assessment": { "method_id": "stripe", "origin_scope": "verified_checkout", "verdict": "possible_attack", "baseline_sufficient": false } }
