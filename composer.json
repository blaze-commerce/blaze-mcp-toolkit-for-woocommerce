{
	"name": "blazecommerce/blaze-mcp-toolkit-for-woocommerce",
	"description": "Read-only WordPress Abilities for WooCommerce store health, exposed to Claude and ChatGPT through MCP.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"Blaze\\McpToolkit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Blaze\\McpToolkit\\Tests\\": "tests/"
		}
	},
	"repositories": [
		{
			"type": "path",
			"url": "vendor-src/commerce-abilities",
			"options": {
				"symlink": false,
				"versions": {
					"woocommerce/commerce-abilities": "0.4.5"
				}
			}
		}
	],
	"require": {
		"php": ">=8.0",
		"woocommerce/commerce-abilities": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "*",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true,
		"optimize-autoloader": true,
		"platform": {
			"php": "8.0.30"
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	}
}
